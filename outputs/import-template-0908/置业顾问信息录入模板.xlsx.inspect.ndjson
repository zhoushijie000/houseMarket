{"kind":"table","sheet":"置业顾问信息","address":"A1:E11","rows":11,"cols":5,"values":[["置业顾问信息录入表",null,null,null,null],["请尽可能完整、准确地提供置业顾问信息，便于购房人联系咨询。",null,null,null,null],["每份表填写一位置业顾问。蓝色区域填写信息或放置图片。",null,null,null,null],[null,null,null,null,null],["置业顾问姓名","",null,null,"填写对外展示的姓名。"],[null,null,null,null,null],["置业顾问手机号","",null,null,"填写本人常用的联系手机号。"],[null,null,null,null,null],["置业顾问微信号","",null,null,"填写微信号，保留字母、数字及符号。"],[null,null,null,null,null],["置业顾问微信二维码","",null,null,"请插入本人的微信二维码图片。\n\n保持图片清晰、完整，按原比例缩放到蓝色区域内。"]]}
